# ---------------------------------------------------------------------------
# .streamlit/secrets.toml.example —— Streamlit Cloud Secrets 模板
#
# 用法：
#   1. 本地开发：把真实的 .streamlit/secrets.toml 建在本地（已被 .gitignore 忽略），
#      或干脆继续用根目录 .env（二者都支持，见 src/paths.py 的 load_env）。
#   2. 云端部署：打开 Streamlit Cloud -> 你的 app -> Settings -> Secrets，
#      把下面内容（填上真实值）整段粘进去，保存后 Reboot app。
#
# 安全约定：
#   - 本文件只有占位符，可以安全提交；含真实值的 secrets.toml 永不提交。
#   - src/paths.py 只把 Secrets 写进 os.environ，从不打印或回显任何键值。
#   - 若同时存在 .env 与 Secrets，已存在的环境变量优先，不会被覆盖。
# ---------------------------------------------------------------------------

# ---- 必填：智谱 AI 开放平台 API Key（RAG 向量化 / 生成 / Function Calling）----
ZHIPU_API_KEY = "sk-在这里填入你的真实Key"

# ---- 可选：模型与端点覆盖（不写则用脚本默认值）----
# ZHIPU_BASE_URL = "https://open.bigmodel.cn/api/paas/v4"
# ZHIPU_EMBED_MODEL = "embedding-3"
# ZHIPU_CHAT_MODEL = "glm-4-flash"

# ---- 可选：MongoDB（云端 localhost 不可用，请填 Atlas 连接串）----
# 未配置时模块三 / 模块五会给出友好错误提示，页面不会崩。
# MONGO_URI = "mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# MONGO_DB = "agent_db"
# MONGO_COLLECTION = "students"

# ---- 可选：MCP 子进程解释器（默认当前解释器 sys.executable）----
# MCP_PYTHON = "/usr/local/bin/python"
