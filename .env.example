# ---------------------------------------------------------------------------
# .env.example —— 环境变量模板（本文件不含真实密钥，可以安全提交）
#
# 使用方法（本地）：把本文件复制为同目录下的 .env，再填入真实值
#     copy .env.example .env          （Windows CMD / PowerShell 均可）
#
# 云端（Streamlit Cloud）：不要上传 .env，改为在
#     Manage app -> Settings -> Secrets 里按同样键名填写（TOML 格式），
#     内容模板见 .streamlit/secrets.toml.example。
#     src/paths.py 的 load_env() 会把 Secrets 写进 os.environ，脚本无需改动。
#
# 重要：
#   1. 必须保存为 UTF-8 无 BOM。若带 BOM，第一个键名会变成
#      "\ufeffZHIPU_API_KEY"，脚本将读不到，症状是"明明配了却说没配"。
#   2. 键值两侧不要加引号、不要留空格，也不要写 export。
#   3. .env 已被 .gitignore 忽略，不会提交；本模板文件会被提交。
# ---------------------------------------------------------------------------

# ---- 必填：智谱 AI 开放平台 API Key ----
# 获取地址：https://open.bigmodel.cn/  ->  API Keys
# 用途：embedding-3 向量化 与 glm-4-flash 生成回答（RAG / 查询改写 / Function Calling 共用）
ZHIPU_API_KEY=sk-在这里填入你的真实Key

# ---- 以下全部可选，不写则使用各脚本内的默认值 ----

# 智谱 OpenAI 兼容端点
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_EMBED_MODEL=embedding-3
ZHIPU_CHAT_MODEL=glm-4-flash

# 本地 Ollama 降级引擎（用于离线演示；云端通常不可用）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- MongoDB（模块三「查学生」与模块五 Function Calling 使用）----
# 本地默认值 mongodb://localhost:27017/ 在 Streamlit Cloud 上不可用，
# 云端请填 MongoDB Atlas 连接串（Secrets 中同名键）。
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=agent_db
MONGO_COLLECTION=students

# ---- MCP 子进程解释器（可选）----
# 默认用当前解释器 sys.executable；仅当需要指定别的解释器时才填。
# MCP_PYTHON=/path/to/python
